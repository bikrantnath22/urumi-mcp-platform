{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "production": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
            "minLength": 1
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            },
            "defaultCertificate": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "scheme": {
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "cookieSecure": {
          "type": "boolean"
        },
        "stores": {
          "type": "object",
          "properties": {
            "baseDomain": {
              "type": "string"
            },
            "scheme": {
              "enum": [
                "http",
                "https"
              ]
            }
          }
        }
      }
    }
  }
}
